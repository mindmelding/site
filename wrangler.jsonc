// mindmelding.dev. Static files from this folder; worker.js handles project pages.
// Each product's docs are a separate Worker with its own route, e.g. mindmelding.dev/docs-kit/docs*.
// The more specific route wins, so those paths never reach this Worker.
{
  "name": "mindmelding-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Required by `wrangler preview`, which Workers Builds runs on non-production branches.
  "previews": {},
  "routes": [
    { "pattern": "mindmelding.dev", "custom_domain": true },
    { "pattern": "www.mindmelding.dev", "custom_domain": true }
  ]
}
